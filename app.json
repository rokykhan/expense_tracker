{
  "expo": {
    "name": "হিসাবখাতা",
    "slug": "hisabkhata",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hisabkhata",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.example.hisabkhata",
      "infoPlist": {
        "NSFaceIDUsageDescription": "হিসাবখাতা লক খুলতে ফেস আইডি ব্যবহার করা হয়।"
      }
    },
    "android": {
      "package": "com.example.hisabkhata",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.example.hisabkhata.widgets",
          "groupIdentifier": "group.com.example.hisabkhata",
          "enablePushNotifications": false,
          "enableAndroid": true,
          "widgets": [
            {
              "name": "Summary",
              "displayName": "হিসাবখাতা",
              "description": "আজকের ব্যয় এবং এই মাসের সঞ্চয়",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "initialLayout": "./src/widgets/summary.ios.tsx"
              },
              "android": {
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "initialLayout": "./src/widgets/summary.android.tsx"
              }
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
